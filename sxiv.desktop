[Desktop Entry]
Type=Application
Name=Crop Tool
GenericName=Image Cropper
Comment=Crop images interactively
Exec=/full/path/to/crop %F
Icon=crop
MimeType=image/bmp;image/gif;image/jpeg;image/webp;image/jpg;image/png;image/tiff;image/x-bmp;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-tga;image/x-xpixmap;
Categories=Office;Graphics;Viewer;
NoDisplay=false
Terminal=true
